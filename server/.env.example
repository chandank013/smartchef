PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# --- LLM (pick one provider: groq | openai | gemini | anthropic | mock) ---
# "mock" returns sample recipes with no API key - handy for demos and UI testing.
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional override; defaults: groq=openai/gpt-oss-120b, openai=gpt-4o-mini, gemini=gemini-2.0-flash, anthropic=claude-sonnet-4-6
LLM_MODEL=
LLM_TIMEOUT_MS=30000

# --- Image search (unsplash | pexels | none) ---
IMAGE_PROVIDER=none
IMAGE_API_KEY=

# --- Tuning ---
CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MIN=10